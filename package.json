{
  "name": "sta-mble",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx sim/monte.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && vite build",
    "shot": "node tools/screenshot.mjs",
    "icon": "tsx tools/make-icon.mjs",
    "electron:dev": "start /b vite && electron .",
    "electron:build": "set ELECTRON=1&& vite build && electron-builder"
  },
  "build": {
    "appId": "io.github.stx4r.sirius",
    "productName": "Sirius",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Sirius-v${version}-portable.exe"
    }
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "howler": "^2.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
